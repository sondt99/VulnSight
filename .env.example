# --- AI refinement provider (optional but recommended) ---
# Only "anthropic" (Anthropic Messages API compatible) is implemented.
CVE_AI_PROVIDER=anthropic

# Your endpoint should be Anthropic Messages-API compatible: {BASE_URL}/v1/messages
AI_BASE_URL=https://your-ai-endpoint.example.com
AI_TOKEN=sk-your-token-here
AI_MODEL=model-xyz

# --- Web server ---
PORT=5000
