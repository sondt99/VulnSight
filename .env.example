# --- AI refinement provider (optional but recommended) ---
# Both providers can be configured at once; CVE_AI_PROVIDER picks the active one:
#   anthropic — any Anthropic Messages-API compatible endpoint ({BASE_URL}/v1/messages)
#   glm       — Zhipu/BigModel OpenAI-compatible chat-completions API
CVE_AI_PROVIDER=glm

# anthropic
# ANTHROPIC_BASE_URL=https://your-ai-endpoint.example.com
# ANTHROPIC_TOKEN=sk-your-token-here
# ANTHROPIC_MODEL=model-xyz

# glm — token from open.bigmodel.cn, format "<id>.<secret>".
# GLM_BASE_URL is optional (defaults to https://open.bigmodel.cn/api/paas/v4).
# Multiple keys: comma-separated. On failure the runtime rotates to the next
# key automatically; if all keys fail the request errors out.
GLM_TOKEN=your-key-1,your-key-2,your-key-3
GLM_MODEL=glm-5.3

# Legacy fallback (applies to whichever provider is active, if the prefixed
# vars above are unset): AI_BASE_URL / AI_TOKEN / AI_MODEL

# --- AI classify timeout (optional) ---
# Per-request timeout in seconds for AI classification calls (default 180).
# AI_CLASSIFY_TIMEOUT=180

# --- NVD (optional, speeds up NVD queries 10x) ---
# Free API key from https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 req/30s.  With key: 50 req/30s.
# NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Web server ---
PORT=5000
# Maximum JSON request size accepted by Flask (defaults to 1 MiB).
MAX_REQUEST_BYTES=1048576
